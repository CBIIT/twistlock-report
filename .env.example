# No required server-side secrets for the base application.
# TWISTLOCK_BASE_URL=https://twistlock.nci.nih.gov
# TWISTLOCK_BEARER_TOKEN=<paste-your-twistlock-token>

# Optional: pre-fill credentials for the batch CLI script (scripts/generate-reports.ts)
# If unset, the script will prompt interactively.
# TWISTLOCK_USERNAME=your-username
# TWISTLOCK_PASSWORD=your-password
